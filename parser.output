Grammar

    0 $accept: program $end

    1 program: stmt_list

    2 stmt_list: ε
    3          | stmt_list stmt

    4 stmt: simple_stmt NEWLINE
    5     | compound_stmt
    6     | NEWLINE

    7 simple_stmt: assign_stmt
    8            | print_stmt
    9            | return_stmt

   10 assign_stmt: IDENT ASSIGN expr

   11 print_stmt: KW_PRINT LPAREN expr RPAREN

   12 return_stmt: KW_RETURN expr
   13            | KW_RETURN

   14 compound_stmt: if_stmt
   15              | while_stmt
   16              | func_def

   17 if_stmt: KW_IF expr COLON NEWLINE block elif_list opt_else

   18 elif_list: ε
   19          | elif_list elif_clause

   20 elif_clause: KW_ELIF expr COLON NEWLINE block

   21 opt_else: ε
   22         | KW_ELSE COLON NEWLINE block

   23 while_stmt: KW_WHILE expr COLON NEWLINE block

   24 func_def: KW_DEF IDENT LPAREN opt_params RPAREN COLON NEWLINE block

   25 block: INDENT stmt_list DEDENT

   26 opt_params: ε
   27           | param_list

   28 param_list: IDENT
   29           | param_list COMMA IDENT

   30 expr: or_expr

   31 or_expr: and_expr
   32        | or_expr TOK_OR and_expr

   33 and_expr: not_expr
   34         | and_expr TOK_AND not_expr

   35 not_expr: comparison_expr
   36         | TOK_NOT not_expr

   37 comparison_expr: add_expr
   38                | comparison_expr TOK_EQ add_expr
   39                | comparison_expr TOK_NE add_expr
   40                | comparison_expr TOK_LT add_expr
   41                | comparison_expr TOK_LE add_expr
   42                | comparison_expr TOK_GT add_expr
   43                | comparison_expr TOK_GE add_expr

   44 add_expr: mult_expr
   45         | add_expr TOK_PLUS mult_expr
   46         | add_expr TOK_MINUS mult_expr

   47 mult_expr: unary_expr
   48          | mult_expr TOK_STAR unary_expr
   49          | mult_expr TOK_SLASH unary_expr
   50          | mult_expr TOK_MOD unary_expr

   51 unary_expr: primary_expr
   52           | TOK_MINUS unary_expr

   53 primary_expr: INT_LIT
   54             | BOOL_LIT
   55             | IDENT
   56             | call_expr
   57             | LPAREN expr RPAREN

   58 call_expr: IDENT LPAREN opt_args RPAREN

   59 opt_args: ε
   60         | arg_list

   61 arg_list: expr
   62         | arg_list COMMA expr


