    TOK_SLASH (278) 49
    TOK_MOD (279) 50
    ASSIGN (280) 10
    LPAREN (281) 11 24 58 59 60
    RPAREN (282) 11 24 58 59 60
    COLON (283) 17 20 22 23 24
    COMMA (284) 29 64
    INDENT (285) 25
    DEDENT (286) 25
    NEWLINE (287) 4 6 17 20 22 23 24
    INT_LIT <int_val> (288) 53
    BOOL_LIT <bool_val> (289) 54
    IDENT <str_val> (290) 10 24 28 29 55 59
    UNARY (291)


